{
    "openapi": "3.0.0",
    "info": {
        "title": "YouTube Summarizer Agent",
        "version": "1.0.0",
        "description": "Summarizes YouTube videos and answers questions about it."
    },
    "servers": [
        {
            "url": "http://localhost:3000/api/agents/cly4g3c15000dc1wgy0h6sx74"
        }
    ],
    "paths": {
        "/": {
            "post": {
                "summary": "Handle new video or query",
                "description": "Processes a new message query, with knowledge of the message history.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "messages": {
                                        "type": "array",
                                        "items": {
                                            "type": "object",
                                            "properties": {
                                                "role": {
                                                    "type": "string",
                                                    "description": "Role of the message sender (user or assistant)",
                                                    "example": "user"
                                                },
                                                "content": {
                                                    "type": "string",
                                                    "description": "Content of the message",
                                                    "example": "Can you summarize this video? https://www.youtube.com/watch?v=NgIwYrdIuek&ab_channel=Jubilee"
                                                }
                                            },
                                            "required": ["role", "content"]
                                        }
                                    }
                                },
                                "required": ["messages"]
                            },
                            "examples": {
                                "example-1": {
                                    "summary": "Example request",
                                    "value": {
                                        "messages": [
                                            {
                                                "role": "user",
                                                "content": "Can you summarize this video? https://www.youtube.com/watch?v=NgIwYrdIuek&ab_channel=Jubilee"
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Query processed successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "answer": {
                                            "type": "string",
                                            "description": "Response to the user's query"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "description": "Error message"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {}
}
